
# --- PostgreSQL container (read by docker-compose.yml) -----------------------
POSTGRES_USER=greenhouse
POSTGRES_PASSWORD=greenhouse
POSTGRES_DB=greenhouse
POSTGRES_PORT=5432

# --- Backend -----------------------------------------------------------------
# SQLAlchemy URL, not a raw postgres:// DSN. The +psycopg suffix selects the
# psycopg 3 driver. Host is localhost because the API runs outside Compose.
DATABASE_URL=postgresql+psycopg://greenhouse:greenhouse@localhost:5432/greenhouse

API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
